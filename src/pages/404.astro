---
// GitHub Pages serves dist/404.html for unknown URLs.
import Base from '../layouts/Base.astro';
import ContourField from '../components/ContourField.astro';
---
<Base lang="uk" page="404" title="404">
  <section class="relative overflow-hidden">
    <ContourField
      w={1600} h={900} mx={0.7} my={0.5} view={[0.1, 0.9, 0.1, 0.9]}
      walkers={1} labels interactive random lava fade="radial" minBox={[0.6, 0.85, 0.3, 0.7]}
      class="absolute inset-0 h-full w-full"
    />
    <div class="container-x relative py-32 sm:py-44">
      <p class="font-mono text-sm text-accent">loss = 404</p>
      <h1 class="knockout mt-4 max-w-xl text-4xl sm:text-5xl font-medium tracking-tight">Сторінка застрягла в локальному мінімумі</h1>
      <p class="knockout mt-4 max-w-xl text-lg text-muted" lang="en">This page got stuck in a local minimum.</p>
      <div class="mt-9 flex w-fit flex-wrap gap-3" data-avoid>
        <a href="/" class="rounded-xl btn-primary px-5 py-3 font-medium">На головну</a>
        <a href="/en/" class="rounded-xl border border-line bg-surface px-5 py-3 font-medium hover:border-brand" lang="en">Home (English)</a>
      </div>
    </div>
  </section>
</Base>
