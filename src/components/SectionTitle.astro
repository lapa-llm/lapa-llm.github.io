---
interface Props { title: string; lead?: string; id?: string; index?: string }
const { title, lead, id, index } = Astro.props;
---
<div class="mb-10 max-w-2xl scroll-mt-24" id={id}>
  {index && <p class="mb-3 font-mono text-xs text-accent">{index}</p>}
  <h2 class="text-2xl sm:text-3xl font-medium tracking-tight">{title}</h2>
  {lead && <p class="mt-3 text-muted text-base sm:text-lg leading-relaxed">{lead}</p>}
</div>
