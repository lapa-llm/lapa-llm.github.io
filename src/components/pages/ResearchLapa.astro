---
// Paper page: Data-Efficient Adaptation of Multilingual LLMs to Ukrainian (UNLP 2026).
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import SectionTitle from '../SectionTitle.astro';
import CopyButton from '../CopyButton.astro';
import Ext from '../Ext.astro';
import { ui, href, type Lang } from '../../i18n/ui';
import { links, bibtex } from '../../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const r = t.research;
---
<Base lang={lang} page="research" slug="research/lapa" title={r.paperTitle}>
  <PageHeader title={r.paperTitle} eyebrow={r.paperLabel} meta={r.paperAuthors} back={{ href: href(lang, 'research'), label: r.back }} seed={21}>
    <a href={links.paperPdf} class="inline-flex items-center gap-2 rounded-xl btn-primary px-4 py-2.5 text-sm font-medium">PDF <Ext /></a>
    <a href={links.paper} class="inline-flex items-center gap-2 rounded-xl border border-line bg-surface px-4 py-2.5 text-sm font-medium hover:border-accent">ACL Anthology <Ext /></a>
    <a href={links.repo} class="inline-flex items-center gap-2 rounded-xl border border-line bg-surface px-4 py-2.5 text-sm font-medium hover:border-accent">{t.cta.github} <Ext /></a>
  </PageHeader>

  <section class="container-x">
    <SectionTitle index="01" title={r.abstractTitle} />
    <p class="max-w-3xl text-lg leading-relaxed">{r.abstract}</p>
  </section>

  <section class="container-x mt-24">
    <SectionTitle index="02" title={r.methodTitle} />
    <ol class="grid gap-x-8 gap-y-10 md:grid-cols-3">
      {r.method.map((m, i) => (
        <li class="border-t border-line pt-5">
          <p class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')} {i < r.method.length - 1 ? '→' : ''}</p>
          <h3 class="mt-3 text-lg font-medium">{m.t}</h3>
          <p class="mt-2 text-muted leading-relaxed">{m.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-x mt-24">
    <SectionTitle index="03" title={r.resultsTitle} />
    <div class="grid gap-8 lg:grid-cols-2">
      <div class="card p-6 sm:p-8">
        <h3 class="text-lg font-medium">{r.tokensTitle}</h3>
        <p class="mt-2 text-muted leading-relaxed">{r.tokensLead}</p>
        <div class="mt-8 space-y-5" role="img" aria-label="Gemma 3: 1.5×, Lapa: 1×">
          <div>
            <div class="mb-1.5 flex justify-between text-sm font-medium"><span>{r.tokensGemma}</span><span class="tabular-nums text-muted">1.5×</span></div>
            <div class="h-4 rounded-full bg-sunken"><div class="h-4 rounded-full bg-muted/50" style="width:100%"></div></div>
          </div>
          <div>
            <div class="mb-1.5 flex justify-between text-sm font-medium"><span class="text-accent">{r.tokensLapa}</span><span class="tabular-nums">1×</span></div>
            <div class="h-4 rounded-full bg-sunken"><div class="h-4 rounded-full bg-accent" style="width:66.7%"></div></div>
          </div>
        </div>
      </div>
      <div>
        <ul class="space-y-3">
          {r.results.map((x) => (
            <li class="flex gap-3 leading-relaxed"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent"></span><span>{x}</span></li>
          ))}
        </ul>
        <p class="mt-5 text-sm text-muted">
          {r.leaderboard} <a class="link" href={links.leaderboard}>{r.lbTitle}</a> · <a class="link" href={links.mamay}>MamayLM</a>
        </p>
      </div>
    </div>
  </section>

  <section class="container-x mt-24">
    <SectionTitle index="04" title={r.roadmapTitle} />
    <ol class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      {r.roadmap.map((x, i) => (
        <li class="border-t border-line pt-4">
          <p class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</p>
          <p class:list={['mt-2 font-medium', i === r.roadmap.length - 1 && 'text-accent']}>{x}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-x mt-24">
    <SectionTitle index="05" title={r.citeTitle} />
    <div class="code-block relative">
      <div class="absolute right-3 top-3"><CopyButton target="bibtex" label={t.cta.copy} done={t.cta.copied} /></div>
      <pre class="p-5 pr-24"><code id="bibtex">{bibtex}</code></pre>
    </div>
  </section>
</Base>
