---
import Base from '../../layouts/Base.astro';
import SectionTitle from '../SectionTitle.astro';
import CopyButton from '../CopyButton.astro';
import Ext from '../Ext.astro';
import Wordmark from '../Wordmark.astro';
import ContourField from '../ContourField.astro';
import { ui, href, type Lang } from '../../i18n/ui';
import { links, stats, snippets, news, grants } from '../../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const h = t.home;
const pageLink = (p: string) => {
  const [page, hash] = p.split('#');
  return href(lang, page) + (hash ? `#${hash}` : '');
};
const fmtDate =(d: string) => {
  const [y, m, day] = d.split('-').map(Number);
  const date = new Date(Date.UTC(y, m - 1, day ?? 1));
  return new Intl.DateTimeFormat(lang === 'uk' ? 'uk-UA' : 'en-GB', {
    day: day ? 'numeric' : undefined, month: 'short', year: 'numeric', timeZone: 'UTC',
  }).format(date);
};
---
<Base lang={lang} page="">
  <!-- Hero: a new random loss landscape on every visit; the minimum lands beside the name, runs descend into it -->
  <section class="hero relative overflow-hidden">
    <div class="container-x relative pt-20 pb-20 sm:pt-28 sm:pb-24 text-center">
      <div class="relative mx-auto w-fit">
        <ContourField
          seed={11} w={1600} h={1000} mx={0.7} my={0.44} view={[0.18, 0.82, 0.22, 0.7]}
          walkers={1} labels interactive lava fade="radial"
          random minBox={[0.24, 0.76, 0.3, 0.62]} avoid={[0.37, 0.63, 0.4, 0.9]}
          class="absolute left-1/2 top-1/2 aspect-[16/10] w-[clamp(900px,135vw,1900px)] max-w-none -translate-x-1/2 -translate-y-1/2"
        />
        <h1 class="hero-in knockout relative py-10 sm:py-14"><Wordmark size="lg" /></h1>
      </div>
      <p class="hero-in d1 knockout relative mx-auto mt-8 max-w-2xl text-xl sm:text-2xl">{h.title}</p>
      <p class="hero-in d1 knockout relative mx-auto mt-4 max-w-xl text-base sm:text-lg text-muted leading-relaxed">{h.lead}</p>
      <div class="hero-in d2 relative mx-auto mt-9 flex w-fit flex-wrap justify-center gap-3" data-avoid>
        <a href={links.demo} class="inline-flex items-center gap-2 rounded-xl btn-primary px-5 py-3 font-medium transition-colors">{t.cta.demo} <Ext /></a>
        <a href={links.hf} class="inline-flex items-center gap-2 rounded-xl border border-line bg-surface px-5 py-3 font-medium hover:border-brand transition-colors">🤗 {t.cta.hf}</a>
        <a href={links.paper} class="inline-flex items-center gap-2 rounded-xl border border-line bg-surface px-5 py-3 font-medium hover:border-brand transition-colors">{t.cta.paper} <Ext /></a>
      </div>
    </div>
  </section>
  <style>
    .hero-in { animation: rise .9s cubic-bezier(.2,.7,.2,1) both; }
    .hero-in.d1 { animation-delay: .12s; }
    .hero-in.d2 { animation-delay: .22s; }
    @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .hero-in { animation: none; } }
  </style>

  <!-- Stats -->
  <section class="container-x">
    <dl class="grid grid-cols-2 gap-x-6 sm:grid-cols-3 lg:grid-cols-5">
      {stats.map((s) => (
        <div class="border-t border-line pt-5 pb-6">
          <dt class="sr-only">{s.label[lang]}</dt>
          <dd class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl font-light tracking-tight tabular-nums text-fg">{s.value}</dd>
          <dd class="mt-2 text-sm text-muted leading-snug">{s.label[lang]}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Features: numbered columns on thin rules, like the stats row -->
  <section class="container-x mt-28">
    <SectionTitle index="01" title={h.featuresTitle} />
    <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {h.features.map((f, i) => (
        <div class="border-t border-line pt-5">
          <p class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-3 text-lg font-medium">{f.t}</h3>
          <p class="mt-2 text-muted leading-relaxed">{f.d}</p>
        </div>
      ))}
    </div>
    <div class="mt-14 flex flex-col gap-4 sm:flex-row sm:items-baseline sm:gap-8">
      <h3 class="shrink-0 text-xs font-medium tracked text-muted">{h.usesTitle}</h3>
      <ul class="flex flex-wrap gap-2">
        {h.uses.map((u) => <li class="rounded-full border border-line px-4 py-2 text-sm">{u}</li>)}
      </ul>
    </div>
  </section>

  <!-- Quick start -->
  <section class="container-x mt-28">
    <SectionTitle index="02" title={h.quickstartTitle} lead={h.quickstartLead} />
    <div class="code-block" data-tabs>
      <div class="flex items-center gap-1 border-b border-white/10 px-3 pt-3 overflow-x-auto" role="tablist">
        {snippets.map((s, i) => (
          <button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'}
            class="tab shrink-0 rounded-t-lg px-3.5 py-2 text-xs font-medium text-white/60 hover:text-white aria-selected:bg-white/10 aria-selected:text-white">{s.label}</button>
        ))}
      </div>
      {snippets.map((s, i) => (
        <div role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} class:list={['relative', i !== 0 && 'hidden']}>
          <div class="absolute right-3 top-3"><CopyButton target={`code-${s.id}`} label={t.cta.copy} done={t.cta.copied} /></div>
          <pre class="p-5 pr-24"><code id={`code-${s.id}`}>{s.code}</code></pre>
        </div>
      ))}
    </div>
  </section>

  <!-- Ecosystem: a list of rows -->
  <section class="container-x mt-28">
    <SectionTitle index="03" title={h.ecosystemTitle} lead={h.ecosystemLead} />
    <ul class="border-t border-line">
      {h.ecosystem.map((e, i) => (
        <li class="border-b border-line">
          <a href={e.url ?? pageLink(e.page ?? '')} class="group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-4 py-5 sm:grid-cols-[3rem_14rem_1fr_auto]">
            <span class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-lg font-medium group-hover:text-accent transition-colors">{e.t}</span>
            <span class="col-start-2 text-muted sm:col-start-auto">{e.d}</span>
            <span class="row-start-1 col-start-3 text-muted transition-transform group-hover:translate-x-1 group-hover:text-accent sm:col-start-4" aria-hidden="true">{e.url ? '↗' : '→'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- News -->
  <section class="container-x mt-28">
    <SectionTitle index="04" title={h.newsTitle} />
    <ol class="divide-y divide-line border-y border-line">
      {news.map((n) => (
        <li>
          <a href={n.url} class="group grid gap-1 sm:grid-cols-[9rem_1fr_auto] items-baseline py-4">
            <time datetime={n.date} class="font-mono text-xs text-muted">{fmtDate(n.date)}</time>
            <span class="font-medium group-hover:text-accent transition-colors">{n.title[lang]}</span>
            <span class="hidden sm:block text-muted group-hover:text-accent"><Ext /></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- Grants and support -->
  <section class="container-x mt-28">
    <SectionTitle index="05" title={h.grantsTitle} lead={h.grantsLead} />
    <ul class="border-t border-line">
      {grants.map((g, i) => (
        <li class="grid grid-cols-[2.5rem_1fr] items-baseline gap-x-4 gap-y-1 border-b border-line py-5 sm:grid-cols-[3rem_16rem_1fr_auto]">
          <span class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-lg font-medium">{g.name}</span>
          <span class="col-start-2 text-muted sm:col-start-auto">{g.what[lang]}</span>
          {g.id && <span class="col-start-2 font-mono text-xs text-muted sm:col-start-auto">{g.id}</span>}
        </li>
      ))}
    </ul>
    <a href={links.paper} class="mt-5 inline-block font-mono text-xs text-muted hover:text-accent">{h.grantsSource} ↗</a>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-tabs]').forEach((root) => {
      const tabs = [...root.querySelectorAll('[role=tab]')];
      tabs.forEach((tab, idx) => {
        const select = () => {
          tabs.forEach((x) => {
            const on = x === tab;
            x.setAttribute('aria-selected', String(on));
            x.tabIndex = on ? 0 : -1;
            document.getElementById(x.getAttribute('aria-controls')).classList.toggle('hidden', !on);
          });
        };
        tab.addEventListener('click', select);
        tab.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!d) return;
          const next = tabs[(idx + d + tabs.length) % tabs.length];
          next.focus(); next.click();
        });
      });
    });
  </script>
</Base>
