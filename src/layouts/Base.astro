---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import { ui, href, pages, type Lang, type Page } from '../i18n/ui';
import { links } from '../data/site';

interface Props { lang: Lang; page: Page | '404'; title?: string; /** URL path when it differs from the nav page, e.g. 'research/lapa' */ slug?: string }
const { lang, page, title } = Astro.props;
const slug = Astro.props.slug ?? page;
const t = ui[lang];
const fullTitle = title ? `${title} · Lapa` : `Lapa · ${t.meta.tagline}`;
const canonical = new URL(href(lang, slug), Astro.site);
const altUk = new URL(href('uk', slug), Astro.site);
const altEn = new URL(href('en', slug), Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        // apply a saved theme before first paint (no flash); otherwise follow the system
        try { const t = localStorage.getItem('lapa-theme'); if (t === 'light' || t === 'dark') d.dataset.theme = t; } catch {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="uk" href={altUk} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altUk} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/fixel/FixelText-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fixel/FixelDisplay-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_US'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn-primary px-3 py-2 rounded-lg">{lang === 'uk' ? 'Перейти до вмісту' : 'Skip to content'}</a>

    <header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
      <div class="container-x flex h-14 items-center gap-6">
        <a href={href(lang)} class="shrink-0" aria-label="Lapa">
          <Wordmark />
        </a>

        <!-- Editorial nav: tracked caps, a thin blue rule under the current page -->
        <nav class="hidden lg:flex h-full items-center gap-7 ml-6" aria-label={lang === 'uk' ? 'Головне меню' : 'Main'}>
          {pages.map((p) => (
            <a href={href(lang, p)}
              class:list={['nav-link relative flex h-full items-center whitespace-nowrap tracked text-[0.68rem] transition-colors',
                p === page ? 'text-fg is-active' : 'text-muted hover:text-fg']}
              aria-current={p === page ? 'page' : undefined}>{t.nav[p]}</a>
          ))}
        </nav>

        <div class="ml-auto flex items-center gap-4">
          <div class="flex items-center font-mono text-xs" aria-label={lang === 'uk' ? 'Мова' : 'Language'}>
            <a href={href('uk', slug)} hreflang="uk" lang="uk" class:list={['px-1', lang === 'uk' ? 'text-fg' : 'text-muted hover:text-fg']} aria-current={lang === 'uk' ? 'true' : undefined}>UA</a>
            <span class="text-line" aria-hidden="true">/</span>
            <a href={href('en', slug)} hreflang="en" lang="en" class:list={['px-1', lang === 'en' ? 'text-fg' : 'text-muted hover:text-fg']} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          </div>
          <button type="button" id="theme-btn" aria-label={t.themeLabel} title={t.themeLabel} class="inline-flex text-muted hover:text-fg">
            <svg class="theme-sun size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="theme-moon size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
          </button>
          <a href={links.github} aria-label="GitHub" class="hidden sm:inline-flex text-muted hover:text-fg">
            <svg class="size-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.370-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.550-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          </a>
          <a href={links.demo} class="hidden lg:inline-flex items-center whitespace-nowrap rounded-md border border-brand px-3 py-1.5 tracked text-[0.65rem] text-fg transition-colors hover:bg-brand hover:text-white">{t.cta.demo}</a>
          <button type="button" id="menu-btn" class="lg:hidden -mr-1 p-2 text-fg" aria-expanded="false" aria-controls="mobile-nav" aria-label={lang === 'uk' ? 'Меню' : 'Menu'}>
            <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h14M3 13h14"/></svg>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="lg:hidden hidden border-t border-line" aria-label={lang === 'uk' ? 'Мобільне меню' : 'Mobile'}>
        <div class="container-x flex flex-col py-4">
          {pages.map((p, i) => (
            <a href={href(lang, p)} class:list={['flex items-baseline gap-4 border-b border-line py-3.5', p === page ? 'text-fg' : 'text-muted']}>
              <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
              <span class="tracked text-sm">{t.nav[p]}</span>
            </a>
          ))}
          <a href={links.demo} class="mt-5 rounded-xl btn-primary px-4 py-3 text-center font-medium">{t.cta.demo}</a>
        </div>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-line">
      <div class="container-x py-10 grid gap-8 sm:grid-cols-[1fr_auto]">
        <div>
          <div class="flex items-center"><Wordmark /></div>
          <p class="mt-3 text-sm text-muted max-w-sm">{t.meta.tagline}. {t.footer.rights}</p>
        </div>
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted sm:justify-end sm:self-end">
          <a class="hover:text-fg" href={links.github}>GitHub</a>
          <a class="hover:text-fg" href={links.hf}>Hugging Face</a>
          <a class="hover:text-fg" href={links.paper}>{t.cta.paper}</a>
          <a class="hover:text-fg" href={links.x}>X</a>
          <a class="hover:text-fg" href={links.telegram}>Telegram</a>
        </div>
      </div>
      <div class="container-x pb-8 text-xs text-muted">© {new Date().getFullYear()} Lapa · {t.footer.built}</div>
    </footer>

    <script is:inline>
      (() => {
        // Theme toggle: flip between light and dark, remember the choice
        const root = document.documentElement;
        const themeBtn = document.getElementById('theme-btn');
        const meta = document.querySelector('meta[name="theme-color"]');
        const current = () => root.dataset.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        const sync = () => {
          const th = current();
          themeBtn?.setAttribute('aria-pressed', String(th === 'light'));
          meta?.setAttribute('content', th === 'light' ? '#ffffff' : '#000000');
        };
        themeBtn?.addEventListener('click', () => {
          const next = current() === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try { localStorage.setItem('lapa-theme', next); } catch {}
          sync();
        });
        matchMedia('(prefers-color-scheme: light)').addEventListener('change', sync);
        sync();
        const btn = document.getElementById('menu-btn');
        const nav = document.getElementById('mobile-nav');
        btn?.addEventListener('click', () => {
          const open = nav.classList.toggle('hidden') === false;
          btn.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('click', async (e) => {
          const b = e.target.closest('[data-copy]');
          if (!b) return;
          const el = document.getElementById(b.dataset.copy);
          if (!el) return;
          try {
            await navigator.clipboard.writeText(el.innerText.trim());
            b.textContent = b.dataset.done;
            setTimeout(() => (b.textContent = b.dataset.label), 1600);
          } catch {}
        });
      })();
    </script>
  </body>
</html>
